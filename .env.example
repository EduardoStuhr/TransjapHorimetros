# Transjap Horímetros — Variáveis de Ambiente Locais
# Copie este arquivo para .env: Copy-Item .env.example .env

# Frontend Next.js (URL da API ASP.NET Core)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5080

# PostgreSQL (Serviço local ou Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=transjap_horimetros
POSTGRES_PORT=5432

# Connection Strings da API (.NET mapeia variáveis no formato ConnectionStrings__Nome)
# Nota: use sempre 127.0.0.1 (evite localhost para evitar problemas de resolução de rede)
ConnectionStrings__Postgres=Host=127.0.0.1;Port=5432;Database=transjap_horimetros;Username=postgres;Password=your_secure_password_here

# Connection String exclusiva para testes de integração (DEVE ser estritamente transjap_horimetros_tests)
TEST_POSTGRES_CONNECTION_STRING=Host=127.0.0.1;Port=5432;Database=transjap_horimetros_tests;Username=postgres;Password=your_secure_password_here
