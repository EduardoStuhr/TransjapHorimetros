# Transjap Horímetros — Variáveis de Ambiente Locais
# Copie este arquivo para .env: Copy-Item .env.example .env

# Frontend Next.js (URL da API ASP.NET Core)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5080
API_URL=http://127.0.0.1:5080
AUTH_REFRESH_COOKIE_DAYS=7

# JWT da API (use um secret aleatorio com pelo menos 32 bytes; nunca versione o valor real)
Authentication__Jwt__SigningKey=replace_with_a_cryptographically_random_secret_of_at_least_32_bytes
Authentication__Jwt__Issuer=TransjapHorimetros
Authentication__Jwt__Audience=TransjapHorimetrosApp

# Evidências fotográficas (prefira AccountUri + Managed Identity em produção)
Storage__Photos__Provider=AzureBlob
Storage__Photos__ContainerName=photo-evidence
Storage__Photos__MaximumFileSizeBytes=10485760
Storage__Photos__AccountUri=https://your_storage_account.blob.core.windows.net
# Alternativa local/legada: mantenha a connection string somente em secret, nunca no Git
Storage__Photos__ConnectionString=DefaultEndpointsProtocol=https;AccountName=replace_me;AccountKey=replace_me;EndpointSuffix=core.windows.net

# Provisionamento unico do primeiro ADMIN (remova os secrets depois do primeiro uso)
BootstrapAdmin__Email=admin@example.com
BootstrapAdmin__Password=replace_with_a_strong_temporary_password
BootstrapAdmin__FullName=Administrador Transjap

# SQL Server 2022 (serviço local ou Docker)
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=transjap_horimetros
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=your_secure_password_here
SQLSERVER_USE_DOCKER=true

# Connection Strings da API (.NET mapeia variáveis no formato ConnectionStrings__Nome)
# Nota: use sempre 127.0.0.1 (evite localhost para evitar problemas de resolução de rede)
ConnectionStrings__DefaultConnection=Server=127.0.0.1,1433;Database=transjap_horimetros;User Id=sa;Password=your_secure_password_here;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30

# Connection String exclusiva para testes de integração (DEVE ser estritamente transjap_horimetros_tests)
TEST_SQLSERVER_CONNECTION_STRING=Server=127.0.0.1,1433;Database=transjap_horimetros_tests;User Id=sa;Password=your_secure_password_here;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30
