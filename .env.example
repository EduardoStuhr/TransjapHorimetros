# Transjap Horímetros — Variáveis de Ambiente Locais
# Copie este arquivo para .env: Copy-Item .env.example .env

# Frontend Next.js (URL da API ASP.NET Core)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5080

# SQL Server 2022 (serviço local ou Docker)
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=transjap_horimetros
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=your_secure_password_here
SQLSERVER_USE_DOCKER=true

# Connection Strings da API (.NET mapeia variáveis no formato ConnectionStrings__Nome)
# Nota: use sempre 127.0.0.1 (evite localhost para evitar problemas de resolução de rede)
ConnectionStrings__DefaultConnection=Server=127.0.0.1,1433;Database=transjap_horimetros;User Id=sa;Password=your_secure_password_here;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30

# Connection String exclusiva para testes de integração (DEVE ser estritamente transjap_horimetros_tests)
TEST_SQLSERVER_CONNECTION_STRING=Server=127.0.0.1,1433;Database=transjap_horimetros_tests;User Id=sa;Password=your_secure_password_here;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30
