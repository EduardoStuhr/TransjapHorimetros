{
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1,1433;Database=transjap_horimetros;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "HourMeterRules": {
    "_comment": "Padrões operacionais provisórios — pendentes de validação com a Transjap. Ver docs/decisoes.md.",
    "DayTransitionToleranceHours": 0.5,
    "MaxPlausibleDailyHours": 24.0,
    "MaxPlausibleHoursPerElapsedHour": 1.0,
    "ElapsedTimeToleranceHours": 0.25,
    "MissingReadingThresholdDays": 2,
    "ClockSkewToleranceSeconds": 300,
    "GeofenceDefaultRadiusMeters": 500,
    "OcrConfidenceThreshold": 0.85
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
