{
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5432;Database=transjap_horimetros;Username=postgres"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "HourMeterRules": {
    "ElapsedTimeToleranceHours": 0.25
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
