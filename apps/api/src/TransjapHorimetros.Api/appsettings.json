{
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1,1433;Database=transjap_horimetros;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;Connection Timeout=30"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "HourMeterRules": {
    "ElapsedTimeToleranceHours": 0.25
  },
